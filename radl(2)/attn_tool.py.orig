import torch
from matplotlib import pyplot as plt
import numpy as np
from math import sqrt
import pandas as pd
from sklearn.metrics import mean_squared_error
from sklearn.metrics import mean_absolute_error
from evaluate import regression_metrics
from load_data import reverse_scale
import matplotlib.dates as mdates


def mse(pred, label):
    loss = (pred[:, 0, :] - label[:, 0, :]) ** 2
    return torch.mean(loss)


def eval_epoch(model, validation_data, device, args, a, b):
    """ Epoch operation in evaluation phase """
    model.eval()
    n_count = 0
    valid_pred = []
    valid_gt = []
    with torch.no_grad():
        for step, (eod, gt, id) in enumerate(validation_data):
            Eod, Gt = eod.to(device), gt.to(device)
            pred = model(Eod, None)
            pred = pred.cuda().data.cpu().numpy()
            pred = pred.reshape((-1, args.code_num, args.forecast_horizon))
            if step == 0:
                valid_pred = pred
                valid_gt = gt
            else:
                valid_pred = np.concatenate((valid_pred, pred), axis=0)
                valid_gt = np.concatenate((valid_gt, gt), axis=0)

    valid_gt, valid_pred = valid_gt.reshape(-1, args.forecast_horizon), valid_pred.reshape(-1, args.forecast_horizon)
    MSE, MAE = mean_squared_error(valid_gt, valid_pred), mean_absolute_error(valid_gt, valid_pred)
    return MSE, MAE, 0


def test_epoch(model, test_data, device, args):
    """ Epoch operation in evaluation phase """
    model.eval()
    test_pred = []
    test_gt = []
    all_adj_att = []
    avg_adj_att = []
    with torch.no_grad():
        for step, (eod, gt) in enumerate(test_data):
            Eod, Gt = eod.to(device), gt.to(device)
            pred, adj_att = model(Eod, True)
            pred, adj_att = pred.cuda().data.cpu().numpy(), adj_att.cuda().data.cpu().numpy()
            pred = pred.reshape((-1, args.code_num, args.forecast_horizon))
            if step == 0:
                test_pred = pred
                test_gt = gt
                all_adj_att = adj_att[:, 0:1].T
            else:
                test_pred = np.concatenate((test_pred, pred), axis=0)
                test_gt = np.concatenate((test_gt, gt), axis=0)
                all_adj_att = np.concatenate((all_adj_att, adj_att[:, 0:1].T), axis=0)
            avg_adj_att.append(adj_att)

    if args.avg_att:
        return test_gt, test_pred, avg_adj_att
    return test_gt, test_pred, all_adj_att


def test_all(model, test_data, optimizer, device, args, a, b):
    model_path = "./save_dict/{}/{}.chkpt".format(args.forecast_horizon, args.model_name)
    checkpoint = torch.load(model_path)
    model.load_state_dict(checkpoint["model"])
    start_epoch = checkpoint["epoch"]
    print("load epoch {} successfully��".format(start_epoch))
    test_gt, test_pred, all_adj_att = test_epoch(model, test_data, device, args)
    if args.avg_att:
        average_matrix = np.zeros((args.code_num, args.code_num))
        for matrix in all_adj_att:
            average_matrix += matrix

        average_matrix /= len(all_adj_att)
        df_avg_att = pd.DataFrame(average_matrix)
        df = pd.read_excel(args.data_path, header=0, index_col=0).iloc[args.length:,]
        del df["AQI"]
        del df["Temp"]
        df_avg_att.columns = df.columns
        df_avg_att.index = df.columns
        df_avg_att = df_avg_att.round(3)
        print("Average adjacency matrices")
        print(df_avg_att)
    else:
        df = pd.read_excel(args.data_path, header=0, index_col=0).iloc[args.length:,]
        del df["AQI"]
        del df["Temp"]
        att_df = pd.DataFrame(all_adj_att, columns=df.columns)
        att_df["Date"] = df.index[::32]
        att_df = att_df.set_index("Date")
        print("Time varying adjacency matrices")
        print(att_df)
