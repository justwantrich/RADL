"""Factory for the dependency-aware spatiotemporal backbone used in RADL training.

The registered name selects which concrete module graph is instantiated; tensor I/O
layouts are unchanged from the historical GWNet-Attn path.
"""
import torch
from model.gwnet import GraphWaveNet
from model.gwnet_att import gwnet


def get_model(device, args):
    model = ""
    if  args.model_name=="GWNet-Attn":
        gating_method = getattr(args, 'gating_method', 'none')
        compact = getattr(args, 'compact_mode', False)

        if compact:
            skip_ch, end_ch, blks, lyrs = 128, 256, 2, 2
        else:
            skip_ch, end_ch, blks, lyrs = 256, 512, 3, 3

        model = gwnet(args.code_num, args.length, dropout=0.3, in_dim=1,
                 out_dim=args.forecast_horizon, residual_channels=32,
                 dilation_channels=32, skip_channels=skip_ch, end_channels=end_ch,
                 kernel_size=2, blocks=blks, layers=lyrs,
                 gating_method=gating_method).to(device)
    return model
