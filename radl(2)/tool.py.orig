"""Training loop, evaluation, and export utilities for the RADL forecasting pipeline.

Normalization hooks and checkpoint naming follow the historical interfaces used
by train.py and test.py; only messaging and comments are tailored to the RADL framing.
"""
import os
import time
import torch
import numpy as np
import pandas as pd
from math import sqrt
from sklearn.metrics import mean_squared_error
from sklearn.metrics import mean_absolute_error
from evaluate import regression_metrics
from load_data import reverse_scale, read_data


def _sanitize_for_filename(s: str) -> str:
    """Return a filesystem-safe fragment for checkpoint and output prefixes."""
    s = str(s)
    # Replace common separators so paths stay portable across platforms
    s = s.replace("\\", "_").replace("/", "_").replace(" ", "_").replace(":", "_")
    return s


def _infer_market_name(args) -> str:
    """
    Infer the primary market (target column) label for run tagging.

    Metrics and exported series use the first column as the headline target; the tag
    therefore defaults to that column name when present in args.feature_names.
    """
    # Prefer names attached during load_EOD_data
    feat_names = getattr(args, "feature_names", None)
    if isinstance(feat_names, (list, tuple)) and len(feat_names) > 0:
        return str(feat_names[0])

    # Else read column names from data_path
    df = read_data(args.data_path, header=0, index_col=0)
    if df is None or df.columns is None or len(df.columns) == 0:
        return "UnknownMarket"
    return str(df.columns[0])


def _build_run_tag(args) -> str:
    """Build a run tag: forecast horizon, lookback length, and primary market label."""
    h = getattr(args, "forecast_horizon", "NA")
    d = getattr(args, "length", "NA")
    market = _sanitize_for_filename(_infer_market_name(args))
    return f"h={h}_d={d}_{market}"


def _checkpoint_path(args) -> str:
    """Checkpoint path including horizon, lookback, and market to limit overwrites."""
    tag = _build_run_tag(args)
    return f"./save_dict/{args.forecast_horizon}/{args.model_name}_{tag}.chkpt"


def _output_prefix(args) -> str:
    """Output filename prefix aligned with the checkpoint naming scheme."""
    tag = _build_run_tag(args)
    return f"{args.model_name}_{tag}"


def mse(pred, label):
    loss = (pred[:, 0, :] - label[:, 0, :]) ** 2
    return torch.mean(loss)


def mae(pred, label):
    loss = (pred - label).abs()
    return torch.mean(loss)


def revin_normalize(x, eps=1e-5):
    """Normalize each sample along the temporal axis (instance-level adaptation).

    Args:
        x: Tensor of shape (B, N, T, F).

    Returns:
        x_norm: Normalized tensor, same shape.
        mean:   (B, N, 1, F) per-node, per-feature mean.
        stdev:  (B, N, 1, F) per-node, per-feature stdev.
    """
    mean = x.mean(dim=2, keepdim=True)
    stdev = (x.var(dim=2, keepdim=True, unbiased=False) + eps).sqrt()
    return (x - mean) / stdev, mean, stdev


def revin_denormalize(pred, mean, stdev):
    """Map forecasts back to the input scale using moments from the forward path.

    Args:
        pred:  (B, N, H) predicted values (first feature assumed).
        mean:  (B, N, 1, F) means stored alongside the normalized window.
        stdev: (B, N, 1, F) standard deviations stored alongside the normalized window.

    Returns:
        Denormalized pred with shape (B, N, H).
    """
    m = mean[:, :, 0, 0].unsqueeze(-1)   # (B, N, 1)
    s = stdev[:, :, 0, 0].unsqueeze(-1)  # (B, N, 1)
    return pred * s + m


def get_concat_adj(data, args):
    arr = 0
    for i, val in enumerate(data):
        if i == 0:
            arr = val
        else:
            arr = np.concatenate((arr, val), axis=0)
    arr = arr.reshape((-1, args.code_num, args.code_num))
    return arr


def train_epoch(model, training_data, optimizer, device, args, epoch=0):
    model.train()
    total_loss = []
    use_revin = getattr(args, 'use_revin', False)
    aux_weight = getattr(args, 'aux_loss_weight', 0.0)

    for step, (eod, gt) in enumerate(training_data):
        Eod, Gt = eod.to(device), gt.to(device)

        if use_revin:
            Eod, rv_mean, rv_std = revin_normalize(Eod)

        optimizer.zero_grad()

        pred = model(Eod, None)

        pred = pred.reshape((-1, args.code_num, args.forecast_horizon))

        if use_revin:
            pred = revin_denormalize(pred, rv_mean, rv_std)

        loss_main = mse(pred, Gt)

        l2_reg = 0
        l2_skip = {"weight_key", "weight_query"}
        for name, param in model.named_parameters():
            if args.model_name == "GWNet-Attn":
                if name not in l2_skip:
                    l2_reg += torch.norm(param, p=2)
            else:
                l2_reg += torch.norm(param, p=2)
        loss_main += args.weight_decay * l2_reg

        if aux_weight > 0:
            loss_aux = aux_weight * ((pred[:, 1:, :] - Gt[:, 1:, :]) ** 2).mean()
            loss_main = loss_main + loss_aux

        loss_main.backward()
        total_loss.append(loss_main.item())

        optimizer.step()

    epoch_loss = sum(total_loss) / len(total_loss)
    return epoch_loss


def eval_epoch(model, validation_data, device, args, a, b):
    model.eval()
    valid_pred = []
    valid_gt = []
    use_revin = getattr(args, 'use_revin', False)
    with torch.no_grad():
        for step, (eod, gt) in enumerate(validation_data):
            Eod, Gt = eod.to(device), gt.to(device)

            if use_revin:
                Eod, rv_mean, rv_std = revin_normalize(Eod)

            pred = model(Eod, None)
            pred = pred.reshape((-1, args.code_num, args.forecast_horizon))

            if use_revin:
                pred = revin_denormalize(pred, rv_mean, rv_std)

            pred = pred.data.cpu().numpy()

            if step == 0:
                valid_pred = pred
                valid_gt = gt
            else:
                valid_pred = np.concatenate((valid_pred, pred), axis=0)
                valid_gt = np.concatenate((valid_gt, gt), axis=0)

    valid_gt = valid_gt.reshape(-1, args.forecast_horizon)
    valid_pred = valid_pred.reshape(-1, args.forecast_horizon)
    MSE = mean_squared_error(valid_gt, valid_pred)
    MAE = mean_absolute_error(valid_gt, valid_pred)
    RMSE = sqrt(MSE)
    return MSE, MAE, RMSE


def test_epoch(model, test_data, device, args):
    model.eval()
    test_pred = []
    test_gt = []
    use_revin = getattr(args, 'use_revin', False)
    with torch.no_grad():
        for step, (eod, gt) in enumerate(test_data):
            Eod, Gt = eod.to(device), gt.to(device)

            if use_revin:
                Eod, rv_mean, rv_std = revin_normalize(Eod)

            pred = model(Eod, None)
            pred = pred.reshape((-1, args.code_num, args.forecast_horizon))

            if use_revin:
                pred = revin_denormalize(pred, rv_mean, rv_std)

            pred = pred.data.cpu().numpy()

            if step == 0:
                test_pred = pred
                test_gt = gt
            else:
                test_pred = np.concatenate((test_pred, pred), axis=0)
                test_gt = np.concatenate((test_gt, gt), axis=0)

    return test_gt, test_pred


def train(model, training_data, validation_data, optimizer, device, args, a, b,
          scheduler=None):
    Train_Loss_list = []
    Val_Loss_mse = []
    Val_Loss_mae = []
    # Tag checkpoints by horizon, lookback, and market to avoid silent overwrites
    model_path = _checkpoint_path(args)
    os.makedirs(os.path.dirname(model_path), exist_ok=True)

    best_val_mse = float('inf')
    total_train_time = 0.0
    patience = getattr(args, 'early_stop_patience', 0)
    epochs_no_improve = 0

    sep = "=" * 90
    header = (f"{'Epoch':>8s} | {'Train Loss':>11s} | {'Val MSE':>10s} | "
              f"{'Val MAE':>10s} | {'Val RMSE':>10s} | "
              f"{'LR':>10s} | {'Time':>6s} | Save")

    print(f"\n{sep}")
    print("                              TRAINING STARTED")
    print(sep)
    aux_w = getattr(args, 'aux_loss_weight', 0.0)
    if aux_w > 0:
        print(f"  [Aux Loss] weight = {aux_w}")
    if patience > 0:
        print(f"  [Early Stop] patience = {patience}")
    if scheduler is not None:
        print(f"  [LR Schedule] CosineAnnealing")
    print(header)
    print("-" * 90)

    for epoch_i in range(args.epoch):

        epoch_start = time.time()

        train_loss = train_epoch(model, training_data, optimizer, device, args=args, epoch=epoch_i)
        Train_Loss_list.append(train_loss)

        valid_mse, valid_mae, valid_rmse = eval_epoch(
            model, validation_data, device, args, a, b
        )
        Val_Loss_mse.append(valid_mse)
        Val_Loss_mae.append(valid_mae)

        if scheduler is not None:
            scheduler.step()

        epoch_time = time.time() - epoch_start
        total_train_time += epoch_time

        current_lr = optimizer.param_groups[0]['lr']

        saved_flag = ""
        if valid_mse < best_val_mse:
            best_val_mse = valid_mse
            epochs_no_improve = 0
            checkpoint = {
                'model': model.state_dict(),
                'settings': args,
                'epoch': epoch_i
            }
            torch.save(checkpoint, model_path)
            saved_flag = "<-- Best"
        else:
            epochs_no_improve += 1

        print(f"[{epoch_i + 1:4d}/{args.epoch:4d}] | "
              f"{train_loss:11.6f} | {valid_mse:10.6f} | "
              f"{valid_mae:10.6f} | {valid_rmse:10.6f} | "
              f"{current_lr:10.6f} | {epoch_time:5.1f}s | {saved_flag}")

        if patience > 0 and epochs_no_improve >= patience:
            print(f"\n  [Early Stop] No improvement for {patience} epochs. Stopping at epoch {epoch_i + 1}.")
            break

    print(sep)
    print(f"  Training complete!")
    print(f"  Total time   : {total_train_time:.1f}s ({total_train_time / 60:.1f} min)")
    print(f"  Best Val MSE : {best_val_mse:.6f}")
    print(f"  Model saved  : {os.path.abspath(model_path)}")
    print(sep, "\n")


def test(model, test_data, optimizer, device, args, a, b):
    # Reload the best checkpoint using the same path convention as train()
    model_path = _checkpoint_path(args)

    checkpoint = torch.load(model_path, weights_only=False)
    model.load_state_dict(checkpoint['model'])
    start_epoch = checkpoint['epoch']
    print(f"[Info] Loaded best model from epoch {start_epoch + 1}")

    test_gt, test_pred = test_epoch(model, test_data, device, args)

    test_pred = reverse_scale(args, test_pred, a, b)
    test_gt = reverse_scale(args, test_gt, a, b)

    # Raw panel and its date index
    df = read_data(args.data_path, header=0, index_col=0)
    dates_index = df.index

    # Scalar metrics use the inverse-standardized headline target
    RMSE, MAE, MAPE, RMSLE, u1, d = regression_metrics(
        test_gt[:, 0, :], test_pred[:, 0, :]
    )

    result = pd.DataFrame(
        [[args.model_name, RMSE, MAE, MAPE, RMSLE, u1, d]],
        columns=["Model", "RMSE", "MAE", "MAPE", "RMSLE", "U1", "d"]
    )

    # Align each flattened prediction with the calendar row implied by the sliding window
    # test_gt / test_pred: (N, code_num, H)
    N = test_pred.shape[0]
    H = args.forecast_horizon

    # Window k (0-based) and horizon step h map to df row:
    #   row_idx = args.valid_index + args.length + k + h
    start_idx = args.valid_index + args.length
    max_row_idx = start_idx + (N - 1) + (H - 1)

    if start_idx < 0 or max_row_idx >= len(dates_index):
        raise ValueError(
            f"Date index out of range when constructing test_dates: "
            f"start_idx={start_idx}, max_row_idx={max_row_idx}, len(df)={len(dates_index)}. "
            "Please check args.valid_index/args.length/args.forecast_horizon and data length."
        )

    dates_list = []
    for k in range(N):
        base = start_idx + k
        for h in range(H):
            row_idx = base + h
            dates_list.append(dates_index[row_idx])

    test_dates = np.asarray(dates_list)

    # Flatten headline target and predictions for export
    y_true_1d = test_gt[:, 0, :].reshape(-1)
    y_pred_1d = test_pred[:, 0, :].reshape(-1)

    # Guard against misaligned dates after windowing changes
    assert len(test_dates) == len(y_true_1d), f"Date length {len(test_dates)} != y_true length {len(y_true_1d)}"
    assert len(test_dates) == len(y_pred_1d), f"Date length {len(test_dates)} != y_pred length {len(y_pred_1d)}"

    # Prediction table: Date, TRUE, Pred
    pred_df = pd.DataFrame({
        "Date": test_dates,
        "TRUE": y_true_1d,
        "Pred": y_pred_1d,
    })

    out_dir = "./output/{}".format(args.forecast_horizon)
    os.makedirs(out_dir, exist_ok=True)
    prefix = _output_prefix(args)
    pred_path = f"{out_dir}/pred_df_{prefix}.csv"
    result_path = f"{out_dir}/{prefix}_result.csv"
    pred_df.to_csv(pred_path, index=False)
    result.to_csv(result_path, index=False)
    print(f"[Info] Predictions saved to {pred_path}")
    print(f"[Info] Results saved to {result_path}")

    return result
