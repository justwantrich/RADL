"""Data loading, global scaling, and PyTorch DataLoader construction for RADL training.

Windowing and split indices follow the historical contract expected by train.py.
"""
import os
import pandas as pd
import torch
import torch.utils.data as Data
import numpy as np
import math


def read_data(path, **kwargs):
    ext = os.path.splitext(path)[1].lower()
    if ext == '.csv':
        return pd.read_csv(path, **kwargs)
    elif ext in ('.xls', '.xlsx'):
        return pd.read_excel(path, **kwargs)
    else:
        raise ValueError(f"Unsupported file format '{ext}'. Use .csv or .xlsx")



def scale(args, data):
    a_list = []
    b_list = []
    new_data = 0
    if args.standardization=="min-max":
        a = data.min()
        b = data.max()
        new_data = (data - a) / (b - a)
    elif args.standardization=="z-score":
        for i in range(args.code_num):
            a = data[i,:].mean()
            b = data[i,:].std()
            data[i,:] = (data[i,:] - a) / b
            a_list.append(a)
            b_list.append(b)
        # new_data = (data - a) / b
    return data, a_list, b_list


def reverse_scale(args, test_pred, a, b):
    if args.standardization == "min-max":
        test_pred = test_pred * (b - a) + a
    elif args.standardization == "z-score":
        for i in range(args.code_num):
            test_pred[:,i] = test_pred[:,i]*b[i] + a[i]
        # test_pred = test_pred * b + a
    return test_pred



def merge_adj(pred):
    arr = 0
    for i, val in enumerate(pred):
        if i == 0:
            arr = val
        else:
            arr = np.concatenate((arr, val), axis=0)
    return arr



def load_EOD_data(args):
    df = read_data(args.data_path, header=0, index_col=0)

    if hasattr(args, 'drop_cols') and args.drop_cols:
        for col in args.drop_cols:
            if col in df.columns:
                del df[col]

    args.feature_names = list(df.columns)
    args.code_num = len(df.columns)
    args.trade_day = len(df)

    data = df.T.values
    new_data, a, b = scale(args, data)
    eod_data = new_data.reshape(args.code_num, args.trade_day, args.fea_num)

    return eod_data, a, b


def get_batch(eod_data, offset, seq_len, out_len):

    return eod_data[:, offset:offset + seq_len, :], eod_data[:, offset + seq_len:offset + seq_len + out_len, 0]




def prepare_dataloaders(eod_data, args):
    # Build sliding-window tensors then wrap them in DataLoader instances
    EOD, GT = [], []
    # length=10
    for i in range(eod_data.shape[1] - args.length - args.forecast_horizon + 1):
        eod, gt = get_batch(eod_data, i, args.length, args.forecast_horizon)
        EOD.append(eod)

        gt = gt.reshape(args.code_num, -1)
        GT.append(gt)

    GT = merge_adj(GT).reshape(-1, args.code_num, args.forecast_horizon)
    EOD, GT = np.array(EOD), np.array(GT)

    # train_index = (0,1021)  (1021, 1361) (1361, )  1588 227 454 1587
    train_eod, train_gt  = EOD[:args.train_index], GT[:args.train_index]
    valid_eod, valid_gt  = EOD[args.train_index:args.valid_index], GT[args.train_index:args.valid_index]
    test_eod, test_gt = EOD[args.valid_index:], GT[args.valid_index:]

    train_eod, valid_eod, test_eod = torch.FloatTensor(train_eod), torch.FloatTensor(valid_eod), torch.FloatTensor(test_eod)
    train_gt, valid_gt, test_gt = torch.FloatTensor(train_gt), torch.FloatTensor(valid_gt), torch.FloatTensor(test_gt)

    # train_gt, valid_gt= train_gt.squeeze(), valid_gt.squeeze()
    train_dataset = Data.TensorDataset(train_eod, train_gt)
    valid_dataset = Data.TensorDataset(valid_eod, valid_gt)
    test_dataset = Data.TensorDataset(test_eod, test_gt)


    train_loader = Data.DataLoader(dataset=train_dataset, batch_size=args.batch_size, shuffle=True, drop_last=True)
    valid_loader = Data.DataLoader(dataset=valid_dataset, batch_size=args.batch_size, drop_last=False)
    test_loader = Data.DataLoader(dataset=test_dataset, batch_size=args.batch_size, drop_last=False)

    return train_loader, valid_loader, test_loader









