"""Scalar regression metrics shared by the RADL training and evaluation scripts."""
import pandas as pd
import sklearn
import numpy as np
from sklearn.metrics import mean_squared_error
from sklearn.metrics import mean_absolute_error
from sklearn.metrics import mean_absolute_percentage_error
from sklearn.metrics import r2_score
from sklearn.metrics import mean_squared_log_error


def calculate_ui(y_true, y_pred):
    T = len(y_true)
    numerator = np.sqrt(np.sum((y_true - y_pred) ** 2))
    # denominator = np.sqrt(np.mean(y_true ** 2)) + np.sqrt(np.mean(y_pred ** 2))
    denominator = np.sqrt(np.sum(y_true**2))
    ui = numerator / denominator
    return ui


def calculate_d(observed, predicted):
    """
    Willmott index of agreement (d) between observed and predicted series.

    Args:
        observed: 1-D array-like of observations.
        predicted: 1-D array-like of model outputs (same length as observed).

    Returns:
        Scalar index of agreement in [0, 1] for well-behaved inputs.
    """
    observed = np.array(observed)
    predicted = np.array(predicted)

    mean_observed = np.mean(observed)

    numerator = np.sum(np.abs(observed - predicted))
    denominator = np.sum(np.abs(observed - mean_observed) + np.abs(predicted - mean_observed))

    IA = 1 - (numerator / denominator)

    return IA



def regression_metrics(true, pred):
    RMSE = np.sqrt(mean_squared_error(true,pred))
    MAE = mean_absolute_error(true,pred)
    MAPE = mean_absolute_percentage_error(true,pred)
    RMSLE = np.sqrt(mean_squared_log_error(true, pred))
    r2 = r2_score(true,pred)
    u1 = calculate_ui(true,pred)
    d = calculate_d(true, pred)
    return  RMSE, MAE, MAPE*100, RMSLE*100, u1*100, d   # MSLE, RMSLE,

